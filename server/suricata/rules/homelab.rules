# ===================================================================
# homelab.rules — Reglas personalizadas de IDS/IPS para dc1 (Sudoers LAN)
# ===================================================================
# Red protegida: 192.168.0.0/24 ($HOME_NET)
#
# Rango de SIDs locales: 9000001 - 9000999
#
# Acciones:
#   - alert: Modo IDS / IPS (registra evento en fast.log y eve.json sin descartar)
#   - drop : Modo IPS (descarta el paquete en tiempo real mediante NFQUEUE)
# ===================================================================

# -------------------------------------------------------------------
# 1. PRUEBAS Y VALIDACIÓN DE LABORATORIO (IDS vs IPS)
# -------------------------------------------------------------------
# Prueba de IPS: descarta activamente el paquete si coincide la firma maliciosa
drop tcp any any -> $HOME_NET any (msg:"[HOMELAB-IPS-DROP] Bloqueo en tiempo real: Firma de ataque detectada (TEST_EXPLOIT_PAYLOAD_DROP)"; flow:to_server,established; content:"TEST_EXPLOIT_PAYLOAD_DROP"; nocase; classtype:attempted-admin; sid:9000001; rev:1;)
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IPS-DROP] Bloqueo HTTP: Carga maliciosa en aplicacion web (MALICIOUS_SIMULATION_ATTACK)"; flow:to_server,established; content:"MALICIOUS_SIMULATION_ATTACK"; nocase; classtype:web-application-attack; sid:9000002; rev:1;)

# Prueba de IDS: detecta y genera alerta pero NO bloquea el tráfico
alert tcp any any -> $HOME_NET any (msg:"[HOMELAB-IDS-ALERT] Sonda de prueba detectada (TEST_PROBE_ALERT_ONLY)"; flow:to_server,established; content:"TEST_PROBE_ALERT_ONLY"; nocase; classtype:misc-activity; sid:9000010; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"[HOMELAB-IDS-ALERT] Ping ICMP Echo Request recibido en dc1"; itype:8; classtype:misc-activity; sid:9000011; rev:1;)

# -------------------------------------------------------------------
# 2. DETECCIÓN DE ESCANEOS Y RECONOCIMIENTO DE RED (NIDS)
# -------------------------------------------------------------------
# Escaneo sigiloso NULL scan (sin flags activas)
alert tcp any any -> $HOME_NET any (msg:"[HOMELAB-IDS-ALERT] Reconocimiento de red: Escaneo TCP NULL detectado"; flags:0; classtype:attempted-recon; sid:9000020; rev:1;)

# Escaneo sigiloso XMAS scan (FIN, PSH, URG activos)
alert tcp any any -> $HOME_NET any (msg:"[HOMELAB-IDS-ALERT] Reconocimiento de red: Escaneo TCP XMAS detectado"; flags:FPU; classtype:attempted-recon; sid:9000021; rev:1;)

# Ráfaga de paquetes SYN (posible escaneo Nmap SYN scan o SYN flood)
alert tcp any any -> $HOME_NET any (msg:"[HOMELAB-IDS-ALERT] Posible escaneo de puertos SYN Scan en progreso"; flags:S,12; threshold:type both, track by_src, count 25, seconds 3; classtype:attempted-recon; sid:9000022; rev:1;)

# -------------------------------------------------------------------
# 3. PROTECCIÓN DE SERVICIOS CRÍTICOS (Active Directory / Samba DC)
# -------------------------------------------------------------------
# Ataques de fuerza bruta o sondeo continuo a Kerberos (puerto 88)
alert tcp any any -> $HOME_NET 88 (msg:"[HOMELAB-IDS-ALERT] Sondeo continuo o sospechoso al servicio Kerberos del AD DC"; flags:S; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:9000030; rev:1;)

# Sondeo excesivo a LDAP (puerto 389)
alert tcp any any -> $HOME_NET 389 (msg:"[HOMELAB-IDS-ALERT] Multiples intentos de conexion a LDAP (posible enumeracion de cuentas AD)"; flags:S; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:9000031; rev:1;)

# Intentos reiterados de conexión SMB / CIFS (puerto 445)
alert tcp any any -> $HOME_NET 445 (msg:"[HOMELAB-IDS-ALERT] Trafico SMB repetitivo detectado hacia dc1 (posible sondeo de shares)"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:suspicious-login; sid:9000032; rev:1;)

# -------------------------------------------------------------------
# 4. ACCESO Y FUERZA BRUTA SSH (Puerto 22)
# -------------------------------------------------------------------
# Alerta genérica de apertura de sesión SSH hacia dc1
alert tcp any any -> $HOME_NET 22 (msg:"[HOMELAB-IDS-ALERT] Intento de conexion SSH entrante a dc1"; flags:S; classtype:suspicious-login; sid:9000040; rev:1;)

# Múltiples intentos rápidos de conexión SSH (fuerza bruta)
alert tcp any any -> $HOME_NET 22 (msg:"[HOMELAB-IDS-ALERT] ALERTA CRITICA: Posible ataque de fuerza bruta SSH contra dc1"; flags:S; threshold:type both, track by_src, count 6, seconds 30; classtype:attempted-admin; sid:9000041; rev:1;)

# -------------------------------------------------------------------
# 5. PROTECCIÓN DE APLICACIONES WEB (Nginx / Intranet / Portal)
# -------------------------------------------------------------------
# Inyección SQL básica (patrón UNION SELECT)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Ataque Web: Patron de Inyeccion SQL (UNION SELECT)"; flow:to_server,established; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:9000050; rev:1;)

# Intento de Path Traversal / LFI (lectura de /etc/passwd)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Ataque Web: Intento de Path Traversal hacia /etc/passwd"; flow:to_server,established; content:"/etc/passwd"; nocase; classtype:web-application-attack; sid:9000051; rev:1;)

# Explotación de vulnerabilidad Log4j (JNDI lookup)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Ataque Web: Intento de explotacion Log4Shell (jndi:ldap)"; flow:to_server,established; content:"${jndi:"; nocase; classtype:web-application-attack; sid:9000052; rev:1;)

# -------------------------------------------------------------------
# 6. DETECCIÓN DE ESCÁNERES DE VULNERABILIDADES (OpenVAS, Nikto, Nmap)
# -------------------------------------------------------------------
# Detección de OpenVAS / Greenbone
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Escaneo de vulnerabilidades: OpenVAS / Greenbone detectado"; flow:to_server,established; content:"User-Agent|3a|"; nocase; content:"OpenVAS"; nocase; distance:0; classtype:attempted-recon; sid:9000060; rev:1;)

# Detección de Nikto Web Scanner
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Escaneo de vulnerabilidades: Nikto Web Scanner detectado"; flow:to_server,established; content:"User-Agent|3a|"; nocase; content:"Nikto"; nocase; distance:0; classtype:attempted-recon; sid:9000061; rev:1;)

# Detección de Nmap Scripting Engine (NSE)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Escaneo de vulnerabilidades: Nmap NSE detectado"; flow:to_server,established; content:"User-Agent|3a|"; nocase; content:"Nmap"; nocase; distance:0; classtype:attempted-recon; sid:9000062; rev:1;)

# Detección de Sqlmap
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IDS-ALERT] Herramienta ofensiva: SQLMap detectado"; flow:to_server,established; content:"User-Agent|3a|"; nocase; content:"sqlmap"; nocase; distance:0; classtype:web-application-attack; sid:9000063; rev:1;)

# -------------------------------------------------------------------
# 7. REGLAS IPS ACTIVAS (Bloqueo en tiempo real con acción 'drop')
# -------------------------------------------------------------------
# En modo IPS (ips-toggle.sh --ips), Suricata descarta activamente estos paquetes vía NFQUEUE:
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IPS-DROP] Bloqueo en tiempo real: Inyeccion SQL interceptada y descartada"; flow:to_server,established; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:9000070; rev:1;)
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IPS-DROP] Bloqueo en tiempo real: Directory Traversal interceptado y descartado"; flow:to_server,established; content:"/etc/passwd"; nocase; classtype:web-application-attack; sid:9000071; rev:1;)
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[HOMELAB-IPS-DROP] Bloqueo en tiempo real: Path traversal con ../.. descartado"; flow:to_server,established; content:"../../"; distance:0; classtype:web-application-attack; sid:9000072; rev:1;)

# -------------------------------------------------------------------
# 8. REGLAS BANCARIAS, FRAUDE Y ANTI-DDOS (Fintech / PCI-DSS)
# -------------------------------------------------------------------
# Detección de fuga de datos (DLP): Tarjetas Visa en texto plano en tráfico saliente
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"[BANK-DLP-ALERT] Posible fuga de numero de tarjeta Visa en texto claro"; flow:from_server,established; content:"4"; pcre:"/4[0-9]{12}(?:[0-9]{3})?/"; classtype:policy-violation; sid:9000101; rev:1;)

# Bloqueo de SQL Injection en Login Bancario (' OR '1'='1)
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[BANK-IPS-DROP] Intento de Authentication Bypass SQLi en Home Banking"; flow:to_server,established; content:"' OR '1'='1"; nocase; classtype:web-application-attack; sid:9000102; rev:1;)

# Bloqueo de robo de cookies / sesión en Home Banking (XSS document.cookie)
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[BANK-IPS-DROP] Intento de robo de sesion / XSS en Home Banking"; flow:to_server,established; content:"document.cookie"; nocase; classtype:web-application-attack; sid:9000103; rev:1;)

# Bloqueo activo de escáner Burp Suite en operaciones bancarias
drop tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[BANK-IPS-DROP] Herramienta automatizada no autorizada (Burp Suite)"; flow:to_server,established; content:"User-Agent|3a|"; nocase; content:"Burp"; nocase; distance:0; classtype:web-application-attack; sid:9000104; rev:1;)

# Detección y bloqueo de barrido masivo de puertos (Port Sweep DoS)
drop tcp any any -> $HOME_NET any (msg:"[BANK-IPS-DROP] Barrido masivo de puertos / Reconocimiento agresivo"; flags:S; threshold:type both, track by_src, count 30, seconds 3; classtype:attempted-recon; sid:9000105; rev:1;)

