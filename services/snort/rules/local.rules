# ===================================================================
# local.rules — Reglas de Snort 3 para la infraestructura Sudoers LAN
# ===================================================================
# SIDs locales: 1000001 - 1000999

# Detección IDS (Monitoreo)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"[SNORT3-IDS-ALERT] Ping ICMP recibido"; itype:8; sid:1000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"[SNORT3-IDS-ALERT] Intento de conexion SSH hacia dc1"; flags:S; sid:1000002; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 88 (msg:"[SNORT3-IDS-ALERT] Trafico Kerberos anomalo o sondeo hacia AD DC"; flags:S; sid:1000003; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"[SNORT3-IDS-ALERT] Conexion SMB/CIFS sospechosa a dc1"; flags:S; sid:1000004; rev:1;)

# Prevención IPS (Bloqueo en línea con DAQ)
drop tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"[SNORT3-IPS-DROP] Bloqueo en tiempo real: Ataque simulado (MALICIOUS_SIMULATION_ATTACK)"; content:"MALICIOUS_SIMULATION_ATTACK"; nocase; sid:1000010; rev:1;)
drop tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"[SNORT3-IPS-DROP] Bloqueo en tiempo real: Intento de Path Traversal (/etc/passwd)"; content:"/etc/passwd"; nocase; sid:1000011; rev:1;)
